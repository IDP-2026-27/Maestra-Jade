# =================================================================
# Maestra Jade: Learning Platform - Environment Configuration Example
# =================================================================
# Copy this file to .env or pass flags via Flutter build:
# flutter run -d chrome --dart-define=LLM_API_KEY=YOUR_GEMINI_KEY
# =================================================================

# Google Gemini LLM API Key for Maestra Jade's Socratic Mentor
# Obtain a key at: https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here

# Voice / TTS Settings (Optional override)
TTS_LANGUAGE=en-GB
TTS_VOICE_RATE=0.48
